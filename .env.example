# 이 파일을 .env로 복사한 뒤 값을 바꾼다. .env는 절대 커밋하지 않는다.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
# Worker → backend 내부 API 토큰 (32자 이상). 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_TOKEN=change-me-to-a-random-32-plus-char-token

# 실제 위협정보 피드(Phishing.Database, MIT)를 쓰려면 아래 주석을 푼다. 비워 두면 testsites 모의 피드를 쓴다.
# 켜면 목록의 실제 피싱 사이트가 격리 Worker로 조사되므로 허가된 환경에서만 쓴다.
# FEED_URL=https://phish.co.za/latest/phishing-links-NEW-today.txt
# FEED_CHECKSUM_URL=https://raw.githubusercontent.com/Phishing-Database/checksums/master/phishing-links-NEW-today.txt.sha256
# FEED_SOURCE=phishing.database
# FEED_MAX_PER_RUN=20

# AI 판정(선택). none(기본)이면 규칙 판정만 한다. laya 또는 qwen으로 바꾸고 같은 이름의 프로필로 띄운다.
#   docker compose --profile qwen up -d --build
# 모델 서버는 인터넷이 없는 ai 네트워크에만 붙는다. 처음 빌드할 때만 가중치(Laya 0.7GB / Qwen3 1.8GB)를 받는다.
# AI_MODEL=none

# AI 검토 보조(선택, 기본 꺼짐). 검토 필요 사건의 판정 초안을 Claude가 남기고 확정은 사람이 한다.
# 켜면 의심 페이지 요약(제목·본문 발췌·폼 구조)이 Anthropic으로 나간다(쿠키·입력값·스크린샷은 보내지 않음).
#   docker compose --profile ai-review up -d
# AI_REVIEW_ENABLED=true
# ANTHROPIC_API_KEY=
# AI_REVIEW_MAX_PER_DAY=50

# 가상 조사자(자동화 시험용). agent- 계정은 조사자만 가능하고 판정을 확정할 수 없다.
#   docker compose exec backend python -m app.cli create-user --username agent-inv1 --role investigator
#   AGENT_USER=agent-inv1 AGENT_PASSWORD=... python agents/virtual_investigator.py --size 10
