{
 "_note": "D2 공격 시나리오 15종(기획서 2.6절 R5: 15종 전부 차단). expect의 모든 조건을 만족해야 '차단'이다. url이 http로 시작하지 않으면 http://testsites:8080을 붙인다.",
 "scenarios": [
  {"id": "D2-01", "name": "SSRF: 클라우드 메타데이터로 리다이렉트", "url": "/ssrf-metadata",
   "expect": {"status_in": ["failed"], "reason_in": ["blocked_by_policy"]}},
  {"id": "D2-02", "name": "SSRF: 루프백(127.0.0.1)으로 리다이렉트", "url": "/ssrf-localhost",
   "expect": {"status_in": ["failed"], "reason_in": ["blocked_by_policy"]}},
  {"id": "D2-03", "name": "SSRF: 사설 IP(10.0.0.1)로 리다이렉트", "url": "/d2/ssrf-private",
   "expect": {"status_in": ["failed"], "reason_in": ["blocked_by_policy"]}},
  {"id": "D2-04", "name": "SSRF: 내부 서비스 이름(backend)으로 리다이렉트", "url": "/d2/ssrf-internal-service",
   "expect": {"status_in": ["failed"], "reason_in": ["blocked_by_policy", "navigation_error"]}},
  {"id": "D2-05", "name": "DNS: 공개 이름이 루프백 주소로 풀림(localtest.me)", "url": "http://localtest.me/",
   "expect": {"status_in": ["failed"], "reason_in": ["blocked_by_policy", "navigation_error"]}},
  {"id": "D2-06", "name": "DNS 리바인딩: 조회마다 127.0.0.1/10.0.0.1로 바뀌는 이름", "url": "http://7f000001.0a000001.rbndr.us/",
   "expect": {"status_in": ["failed"], "reason_in": ["blocked_by_policy", "navigation_error"]}},
  {"id": "D2-07", "name": "무한 리다이렉트", "url": "/loop/a",
   "expect": {"status_in": ["failed"], "reason_in": ["too_many_redirects"]}},
  {"id": "D2-08", "name": "14단계 리다이렉트(한도 10 초과)", "url": "/d2/chain/1",
   "expect": {"status_in": ["failed"], "reason_in": ["too_many_redirects"]}},
  {"id": "D2-09", "name": "하위 자원(이미지) 리다이렉트로 메타데이터 유도", "url": "/sub-redirect.html",
   "expect": {"status_in": ["review", "judging"], "subresource_violation": true}},
  {"id": "D2-10", "name": "팝업(새 창 2개, 하나는 메타데이터)", "url": "/d2/popup.html",
   "expect": {"status_in": ["review", "judging"], "popups_blocked_min": 1}},
  {"id": "D2-11", "name": "실행 파일 자동 다운로드", "url": "/d2/download.html",
   "expect": {"status_in": ["review", "judging", "failed"], "evidence_kinds_subset": ["screenshot", "dom_summary", "redirect_chain", "network_summary"]}},
  {"id": "D2-12", "name": "Service Worker 등록 시도", "url": "/d2/sw.html",
   "expect": {"status_in": ["review", "judging"], "text_not_contains": "SW:registered"}},
  {"id": "D2-13", "name": "프롬프트 인젝션(가짜 SYSTEM 지시로 정상 판정 유도)", "url": "/prompt-injection.html",
   "expect": {"status_in": ["review", "judging"], "verdict_not": ["BENIGN"], "injection_detected": true}},
  {"id": "D2-14", "name": "저장형 XSS(제목·본문·입력 이름·placeholder·javascript: 링크)", "url": "/d2/xss-form.html",
   "expect": {"status_in": ["review", "judging"], "console_no_dialog": true}},
  {"id": "D2-15", "name": "대용량 문서(약 40MB 글자·2만 개 입력칸)", "url": "/d2/huge.html",
   "expect": {"status_in": ["review", "judging", "failed"], "dom_summary_max_bytes": 1048576, "worker_alive": true}}
 ]
}
